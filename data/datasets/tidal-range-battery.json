	"title": {
		"fr": "Marnage moyen annuel à New York",
		"en": "Annual mean tidal range at New York"
	},
	"unit": "cm",
	"source": {
		"label": "Tides and Currents — The Battery, New York",
		"url": "https://tidesandcurrents.noaa.gov/stationhome.html?id=8518750",
